# Doxyfile template for DisLMDB
# This file will be processed by CMake to generate the final Doxyfile

PROJECT_NAME           = "DisLMDB"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Distributed Lightning Memory-Mapped Database"
PROJECT_LOGO           = 
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@
INPUT                  = @DOXYGEN_INPUT_DIR@ @CMAKE_CURRENT_SOURCE_DIR@/src
FILE_PATTERNS          = *.h *.c
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
SHOW_INCLUDE_FILES     = YES
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
SEARCHENGINE           = YES
HAVE_DOT               = YES
UML_LOOK               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 4
DOT_TRANSPARENT        = YES
EXCLUDE_PATTERNS       = */build/* */lib/* */bin/*
EXAMPLE_PATH           = @CMAKE_CURRENT_SOURCE_DIR@/examples
EXAMPLE_PATTERNS       = *.c
EXAMPLE_RECURSIVE      = YES
# Project narrative lives in README.rst (includes TRIBUTE_HOWARD_CHU.rst).
# Doxygen does not treat RST as a main page — API docs come from headers.
USE_MDFILE_AS_MAINPAGE =
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = NO
DISTRIBUTE_GROUP_DOC   = YES
GROUP_NESTED_COMPOUNDS = YES
SUBGROUPING            = YES
INLINE_GROUPED_CLASSES = YES

# Enable source browser
SOURCE_BROWSER         = YES 
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES
VERBATIM_HEADERS       = YES

# Add theme support
HTML_EXTRA_STYLESHEET  = 
HTML_COLORSTYLE_HUE    = 210
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80

# Add tags file
GENERATE_TAGFILE       = @DOXYGEN_OUTPUT_DIR@/dislmdb.tag
ALLEXTERNALS           = NO
EXTERNAL_GROUPS        = YES
EXTERNAL_PAGES         = YES

# Layout options
LAYOUT_FILE            = 
ALPHABETICAL_INDEX     = YES
COLS_IN_ALPHA_INDEX    = 5
IGNORE_PREFIX          = 

# Add diagrams for data structures
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDED_BY_GRAPH      = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
CLASS_GRAPH            = YES

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = @CMAKE_CURRENT_SOURCE_DIR@/include
INCLUDE_FILE_PATTERNS  = *.h
PREDEFINED             = 
EXPAND_AS_DEFINED      = 

# Additional settings
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = @DOXYGEN_OUTPUT_DIR@/doxygen_warnings.log 