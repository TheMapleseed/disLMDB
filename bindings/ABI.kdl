// DisLMDB stable C ABI contract (Phase H).
// High-level bindings must link libdislmdb and consume only these symbols
// (plus LMDB MDB_* types already re-exported via dislmdb.h).

abi version="1.0" {
  headers {
    public "include/dislmdb.h"
    public "include/dislmdb_errors.h"
    public "include/dislmdb_network.h"
    public "include/dislmdb_consensus.h"
    public "include/dislmdb_crypto.h"
    public "include/dislmdb_quic.h"
  }

  library name="dislmdb" soname="libdislmdb" {
    requires "pthread"
    requires "z" // DISLMDB_BYTECODE_COMPRESS
    // Host crypto: Security.framework (Darwin) or libcrypto (elsewhere)
    // mTLS: vendored mbedtls (static into libdislmdb)
  }

  env {
    fn dislmdb_version
    fn dislmdb_strerror
    fn dislmdb_env_config_init
    fn dislmdb_env_create
    fn dislmdb_env_open
    fn dislmdb_env_close
    fn dislmdb_txn_begin
    fn dislmdb_txn_commit
    fn dislmdb_txn_abort
    fn dislmdb_dbi_open
    fn dislmdb_put
    fn dislmdb_del
    fn dislmdb_index_put
    fn dislmdb_index_del
    fn dislmdb_index_get
    fn dislmdb_index_scan
    fn dislmdb_put_versioned
    fn dislmdb_get_versioned
    fn dislmdb_get_lmdb_txn
    fn dislmdb_get_lmdb_env
  }

  security {
    fn dislmdb_set_cluster_key
    fn dislmdb_get_cluster_key
    fn dislmdb_acl_set_principal
    fn dislmdb_acl_grant
    fn dislmdb_acl_revoke
    fn dislmdb_acl_get
    fn dislmdb_acl_grant_prefix
    fn dislmdb_acl_revoke_prefix
    fn dislmdb_acl_get_prefix
    fn dislmdb_acl_role_define
    fn dislmdb_acl_role_undefine
    fn dislmdb_acl_role_get
    fn dislmdb_acl_role_assign
    fn dislmdb_acl_role_unassign
    fn dislmdb_acl_effective
  }

  topology {
    fn dislmdb_add_node
    fn dislmdb_get_topology_mode
    fn dislmdb_shard_map_set
    fn dislmdb_shard_map_get
    fn dislmdb_shard_lookup
    fn dislmdb_topo_map_publish
    fn dislmdb_topo_forward_put
    fn dislmdb_topo_forward_del
    fn dislmdb_topo_forward_get
    fn dislmdb_topo_get
  }

  metrics {
    fn dislmdb_get_metrics
    fn dislmdb_format_metrics
    fn dislmdb_export_metrics_file
  }

  notes {
    // Opaque DISLMDB_env / DISLMDB_txn — never layout-dependent across majors.
    // enable_acl default false; persisted with grants; COMPRESS needs zlib.
    // Metrics: format_metrics only — no in-process scrape HTTP (sidecar forever).
    // dislmdb_txn_commit always consumes the txn (success or fail).
    // Forward RPC FWD3: origin==sender_id; principal==origin or ACL delegate.
    // FWD_OP_TXN = atomic multi-op forward (index_put/del under auto-forward).
    // SYNC_REQUEST SYN2: origin bound + asserted principal authorized + OPLG ACL.
    // Reserved DBI names (__*) rejected from app open / oplog / forward.
    // network.local_port 0 = ephemeral bind (not remapped to 9876).
    // Bindings Open() force SOLO + port 0; C config_init still defaults PBFT.
    // Multi-peer PBFT rejects unsigned messages without a cluster key.
    // Raft InstallSnapshot restore preserves __* sub-DB roots on main DBI.
  }
}
