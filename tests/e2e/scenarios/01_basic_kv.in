# Basic KV put/get/delete with fixed cluster key
VERSION
OPEN path=./e2e_work/01_basic_kv port=29701 persist_key=1
SET_KEY hex=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
BEGIN
PUT db=kv key=alpha value=one
PUT db=kv key=beta value=two
COMMIT
EXPECT_OK
BEGIN readonly
GET db=kv key=alpha
GET db=kv key=beta
ABORT
CHECKPOINT
METRICS
BEGIN
DEL db=kv key=beta
COMMIT
BEGIN readonly
GET db=kv key=beta
ABORT
CLOSE
REOPEN
GET_KEY
BEGIN readonly
GET db=kv key=alpha
ABORT
CLOSE
ECHO scenario_01_complete
